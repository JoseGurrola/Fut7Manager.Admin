<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fuente de iconos -->
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- Iconos -->
    <sys:String x:Key="IconChangeLeague">&#xE72C;</sys:String>
    <sys:String x:Key="IconTeams">&#xE902;</sys:String>
    <sys:String x:Key="IconPlayers">&#xE77B;</sys:String>
    <sys:String x:Key="IconMatches">&#xE787;</sys:String>
    <sys:String x:Key="IconPlus">&#xE710;</sys:String>
    <sys:String x:Key="IconTeam">&#xEB0F;</sys:String>
    <sys:String x:Key="IconLeague">⚽</sys:String>
    <sys:String x:Key="IconLocation">&#xE707;</sys:String>
    <sys:String x:Key="IconCalendar">&#xE787;</sys:String>
    <sys:String x:Key="IconDashboard">&#xE9D2;</sys:String>
    <sys:String x:Key="IconStandings">&#xE8FD;</sys:String>

    <!-- Iconos para pestañas de clasificación -->
    <sys:String x:Key="IconGroups">&#xE902;</sys:String>
    <!-- 👥 grupos -->
    <sys:String x:Key="IconGeneral">&#xE9D2;</sys:String>
    <!-- 📊 tabla general -->
    <sys:String x:Key="IconTopScorers">⚽</sys:String>
    <!-- ⚽ goleadores -->
    <sys:String x:Key="IconYellowCards">&#xE7BA;</sys:String>
    <!-- ⚠ amarillas -->
    <sys:String x:Key="IconRedCards">&#xE711;</sys:String>
    <!-- ⛔ rojas -->

    <!-- Window controls -->
    <sys:String x:Key="IconMinimize">&#xE921;</sys:String>
    <sys:String x:Key="IconMaximize">&#xE922;</sys:String>
    <sys:String x:Key="IconRestore">&#xE923;</sys:String>
    <sys:String x:Key="IconClose">&#xE8BB;</sys:String>
    


    <!-- Icono de botones-->
    <Style x:Key="IconTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
