<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fut7Manager.Admin.Converters">
    <local:LeagueStatusConverter x:Key="LeagueStatusConverter"/>
    <local:LeagueStatusToBrushConverter x:Key="LeagueStatusToBrushConverter"/>
    <local:SafeImageConverter x:Key="SafeImageConverter"/>
    <!--DataTemplate para mostrar las ligas como tarjetas-->
    <DataTemplate x:Key="LeagueCardTemplate">
        <Border x:Name="card"
            Width="240"
            MinHeight="180"
            Margin="12"
            Padding="16"
            CornerRadius="16"
            Background="#3F5368"
            BorderBrush="#00000000"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding LogoUrl, Converter={StaticResource SafeImageConverter}}"
                                    Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- fallback -->
                    <TextBlock Text="{StaticResource IconLeague}"
                           FontSize="40" Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- INFO -->
                <StackPanel Grid.Row="1" Margin="0,12,0,10">

                    <!-- NAME -->
                    <TextBlock Text="{Binding Name}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,6,0,4"/>

                    <!-- PRICE -->
                    <TextBlock Text="{Binding RegistrationFee, StringFormat='${0:N2}'}"
                           Foreground="#2ECC71"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,4,0,2"/>

                    <!-- STATUS -->
                    <TextBlock Text="{Binding Status, Converter={StaticResource LeagueStatusConverter}}"
                           Foreground="#D0D7DE"
                           FontSize="14"
                           FontWeight="Medium"
                           TextAlignment="Center"/>

                </StackPanel>

                <!-- STATUS LINE -->
                <Border Grid.Row="2"
                    Height="2"
                    Margin="30,10,30,0"
                    CornerRadius="2"
                    Background="{Binding Status, Converter={StaticResource LeagueStatusToBrushConverter}}"/>

            </Grid>
        </Border>

        <!-- INTERACTIONS -->
        <DataTemplate.Triggers>

            <!-- HOVER -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="card" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                    </Setter.Value>
                </Setter>

                <Setter TargetName="card" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <!-- SELECTED -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="#1ABC9C"/>
                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
            </DataTrigger>

        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>