<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Fut7Manager.Admin.Controls"
                    xmlns:common="clr-namespace:Fut7Manager.Admin.Views.Common">
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <Style TargetType="{x:Type controls:LoadingContainer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LoadingContainer}">

                    <Grid>

                        <!-- CONTENIDO -->
                        <ContentPresenter/>

                        <!-- OVERLAY -->
                        <Border x:Name="Overlay"
                                Background="#66FFFFFF"
                                Opacity="0"
                                IsHitTestVisible="False">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <common:LoadingSpinner Width="50" Height="50"/>

                                <TextBlock Text="Cargando..."
                                           Margin="0,10,0,0"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- 🔥 TRIGGERS -->
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsLoading" Value="True">

                            <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="Overlay" Property="IsHitTestVisible" Value="True"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>