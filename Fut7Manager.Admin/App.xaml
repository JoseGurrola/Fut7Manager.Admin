<Application x:Class="Fut7Manager.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fut7Manager.Admin.Converters">

    <Application.Resources>

        <ResourceDictionary>

            <!-- 🔥 PRIMERO: Merged -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Inputs.xaml"/>
                <ResourceDictionary Source="Styles/ToolTips.xaml"/>
                <ResourceDictionary Source="Styles/ListBoxes.xaml"/>
                <ResourceDictionary Source="Styles/DateTemplates.xaml"/>

                <ResourceDictionary Source="Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BitmapImage x:Key="DefaultTeamLogo"
                         UriSource="pack://application:,,,/Assets/team_placeholder.png"/>

            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
            <conv:HalfConverter x:Key="HalfConverter"/>
            <conv:LeagueStatusConverter x:Key="LeagueStatusConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        </ResourceDictionary>

    </Application.Resources>

</Application>