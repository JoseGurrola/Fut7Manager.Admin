<Window x:Class="Fut7Manager.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fut7Manager.Admin.ViewModels"
        xmlns:views="clr-namespace:Fut7Manager.Admin.Views"
        Title="Admin Liga" Height="600" Width="1000">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <!-- Players -->
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView/>
        </DataTemplate>

        <!-- Teams -->
        <DataTemplate DataType="{x:Type vm:TeamsViewModel}">
            <views:TeamsView/>
        </DataTemplate>

        <!-- Leagues -->
        <DataTemplate DataType="{x:Type vm:LeaguesViewModel}">
            <views:LeaguesView/>
        </DataTemplate>

        <!-- Matches -->
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView/>
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2C3E50">

            <TextBlock Text="⚽ Admin Liga"
                       Foreground="White"
                       FontSize="18"
                       Margin="10"
                       FontWeight="Bold"/>

            <Button Content="Players" Margin="10" Padding="10"
Background="#34495E" Foreground="White"
BorderBrush="Transparent" Command="{Binding ShowPlayersCommand}"/>
            <Button Content="Teams" Margin="10" Padding="10"
Background="#34495E" Foreground="White"
BorderBrush="Transparent" Command="{Binding ShowTeamsCommand}"/>
            <Button Content="Matches" Margin="10" Padding="10"
Background="#34495E" Foreground="White"
BorderBrush="Transparent" Command="{Binding ShowMatchesCommand}"/>
            <Button Content="Leagues" Margin="10" Padding="10"
Background="#34495E" Foreground="White"
BorderBrush="Transparent" Command="{Binding ShowLeaguesCommand}"/>
        </StackPanel>

        <!-- CONTENIDO DINÁMICO -->
        <ContentControl Content="{Binding CurrentView}" Grid.Column="1"/>

    </Grid>
</Window>