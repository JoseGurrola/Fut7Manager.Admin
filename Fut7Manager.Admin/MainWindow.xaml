<Window x:Class="Fut7Manager.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Fut7Manager.Admin.ViewModels"
        xmlns:views="clr-namespace:Fut7Manager.Admin.Views"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Admin Liga" Height="650" Width="1000"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome
        CaptionHeight="0"
        ResizeBorderThickness="5"
        GlassFrameThickness="0"
        UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Login -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>

        <!-- League selection -->
        <DataTemplate DataType="{x:Type vm:LeagueSelectionViewModel}">
            <views:LeagueSelectionView/>
        </DataTemplate>

        <!-- Players -->
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView/>
        </DataTemplate>

        <!-- Teams -->
        <DataTemplate DataType="{x:Type vm:TeamsViewModel}">
            <views:TeamsView/>
        </DataTemplate>

        <!-- Matches -->
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Background="#1F2F3F" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Fut7 Manager"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="White"
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,5,0">
                <Button Width="30" Height="30"
            Click="Minimize_Click"
            Style="{StaticResource WindowControlButton}"
            Content="{StaticResource IconMinimize}"/>

                <Button Width="30" Height="30"
            Click="Maximize_Click"
            Style="{StaticResource WindowControlButton}"
            Content="{StaticResource IconMaximize}"/>

                <Button Width="30" Height="30"
            Click="Close_Click"
            Style="{StaticResource CloseWindowButton}"
            Content="{StaticResource IconClose}"/>
            </StackPanel>
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid  Grid.Column="0" Background="#2C3E50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="10,15">
                    <TextBlock Margin="10" Text="⚽ Administrador de la liga:" 
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" FontWeight="Bold" Foreground="White" FontSize="18"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,15">
                    <TextBlock Text="Liga actual" Foreground="White" FontSize="17" Opacity="0.7" TextAlignment="Center"/>
                    <StackPanel Margin="0,5,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedLeague.Name}" Foreground="LightBlue" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <Button Command="{Binding ChangeLeagueCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Cambiar liga" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconChangeLeague}" FontSize="14" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="2" Margin="10,5,10,15"/>

                <!-- Menú -->
                <StackPanel Grid.Row="3" VerticalAlignment="Top">
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowTeamsCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconTeams}" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Equipos" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowMatchesCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconMatches}" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Calendario" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowPlayersCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconPlayers}" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jugadores" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido dinámico -->
            <ContentControl Content="{Binding CurrentView}" Grid.Column="1" CacheMode="BitmapCache"/>
        </Grid>
    </Grid>
</Window>