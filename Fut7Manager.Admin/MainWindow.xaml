<Window x:Class="Fut7Manager.Admin.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="clr-namespace:Fut7Manager.Admin.ViewModels"
	xmlns:views="clr-namespace:Fut7Manager.Admin.Views"
	xmlns:local="clr-namespace:Fut7Manager.Admin.Converters"
        Title="Fut7 Manager"
        Height="700"
        Width="1300"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:SafeImageConverter x:Key="SafeImageConverter"/>
        <!-- Login -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <!-- League selection -->
        <DataTemplate DataType="{x:Type vm:LeagueSelectionViewModel}">
            <views:LeagueSelectionView/>
        </DataTemplate>
        <!-- Players -->
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView/>
        </DataTemplate>
        <!-- Teams -->
        <DataTemplate DataType="{x:Type vm:TeamListViewModel}">
            <views:TeamListView/>
        </DataTemplate>
        <!-- Matches -->
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView/>
        </DataTemplate>
        <!-- CentralPanel -->
        <DataTemplate DataType="{x:Type vm:CentralPanelViewModel}">
            <views:CentralPanelView/>
        </DataTemplate>
        <!-- Standings  -->
        <DataTemplate DataType="{x:Type vm:StandingsViewModel}">
            <views:StandingsView/>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Barra superior 
        <Grid Background="#1F2F3F" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fut7 Manager"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="White"
                       FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,5,0">
                <Button Width="30" Height="30"
            Click="Minimize_Click"
            Style="{StaticResource WindowControlButton}"
            Content="{StaticResource IconMinimize}"/>
                <Button Width="30" Height="30"
            Click="Maximize_Click"
            Style="{StaticResource WindowControlButton}"
            Content="{StaticResource IconMaximize}"/>
                <Button Width="30" Height="30"
            Click="Close_Click"
            Style="{StaticResource CloseWindowButton}"
            Content="{StaticResource IconClose}"/>
            </StackPanel>
        </Grid>-->
        <!-- Contenido principal -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <Grid  Grid.Column="0" Background="#2C3E50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <TextBlock Margin="10" Text="Administrador ligas de futbol" 
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" FontWeight="Bold" Foreground="White" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0">
                    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedLeague.Name}" 
                            Foreground="LightBlue" 
                            FontSize="16" 
                            FontWeight="Bold"
                            TextWrapping="Wrap" 
                            HorizontalAlignment="Center"/>
                        <!-- LOGO DE LA LIGA -->
                        <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,10,0,10">
                            <!-- Fondo circular -->
                            <Ellipse Fill="Transparent"/>
                            <!-- Imagen recortada en círculo -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedLeague.LogoUrl, 
                                        Converter={StaticResource SafeImageConverter}}"  
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Fallback (icono) -->
                            <TextBlock Text="{StaticResource IconLeague}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"  FontSize="50">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLeague.LogoUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedLeague.LogoUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- INFO -->
                        <TextBlock Text="{Binding SelectedLeague.Status, 
                            Converter={StaticResource LeagueStatusConverter}}"  
                                   Foreground="LightBlue" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center"/>
                        <Button Command="{Binding ChangeLeagueCommand}" 
                                Style="{StaticResource IconButtonStyle}" 
                                ToolTip="Cambiar liga" 
                                Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" 
                                           Text="{StaticResource IconChangeLeague}" 
                                           FontSize="14" 
                                           Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Separator Grid.Row="2" Margin="10,5,10,15"/>
                <!-- Menú -->
                <StackPanel Grid.Row="3" VerticalAlignment="Top">
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowCentralPanelCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" 
                                       Text="{StaticResource IconDashboard}" 
                                       FontSize="28" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Panel central" 
                                       FontSize="14" 
                                       Margin="0,5,0,0" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowStandingsCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" 
                                       Text="{StaticResource IconStandings}" 
                                       FontSize="28" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Clasificación" 
                                       FontSize="14" 
                                       Margin="0,5,0,0" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" 
                            Command="{Binding ShowMatchesCommand}" 
                            IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" 
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" 
                                       Text="{StaticResource IconMatches}" 
                                       FontSize="28" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Calendario" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowTeamsCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconTeams}" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Equipos" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowPlayersCommand}" IsEnabled="{Binding CanNavigate}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource IconPlayers}" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jugadores" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <!-- Contenido dinámico -->
            <ContentControl Content="{Binding CurrentView}" Grid.Column="1" CacheMode="BitmapCache"/>
        </Grid>
    </Grid>
</Window>