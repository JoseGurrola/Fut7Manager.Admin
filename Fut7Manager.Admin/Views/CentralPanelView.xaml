<UserControl x:Class="Fut7Manager.Admin.Views.CentralPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="clr-namespace:Fut7Manager.Admin.Controls"
            xmlns:oxy="http://oxyplot.org/wpf" xmlns:conv="clr-namespace:Fut7Manager.Admin.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             Background="{StaticResource BackgroundWindowBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- ===================== -->
        <!-- CARD STYLE -->
        <!-- ===================== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundWindowBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource SidebarHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===================== -->
        <!-- DEFAULT -->
        <!-- ===================== -->
        <DataTemplate x:Key="DefaultTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Width="180">
                <TextBlock Text="Estado: " FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Grupos: " FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
                <TextBlock Text="Equipos: " FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>
        </DataTemplate>
        <!-- ===================== -->
        <!-- UPCOMING -->
        <!-- ===================== -->
        <DataTemplate x:Key="UpcomingTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"></RowDefinition>
                    <RowDefinition Height="4*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" >

                    <Border Width="300" 
            Height="305"
            HorizontalAlignment="Left"
            Style="{StaticResource CardStyle}"
            BorderBrush="{StaticResource SidebarHoverBrush}"
            BorderThickness="1.2"
            CornerRadius="18">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Equipo"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="Gray"/>

                                <TextBlock Grid.Column="1"
                           Text="Jugadores"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="Gray"
                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- LINEA -->
                            <Border Grid.Row="1" Height="1" Background="#22000000"/>

                            <!-- LISTA -->
                            <ListBox Grid.Row="2"
         ScrollViewer.VerticalScrollBarVisibility="Hidden"
         ItemsSource="{Binding Teams}"
         HorizontalAlignment="Stretch"
         HorizontalContentAlignment="Stretch"
         BorderThickness="0"
         Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border Padding="6,3"
        Margin="0,1"
        CornerRadius="6"
        Background="Transparent">

                                            <Border.Style>
                                                <Style TargetType="Border">

                                                    <!-- DEFAULT = COMPLETO -->
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Background" Value="#1527AE60"/>

                                                    <Style.Triggers>

                                                        <!-- INCOMPLETO -->
                                                        <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                                                            <Setter Property="Background" Value="#22E74C3C"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </Border.Style>

                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- NOMBRE -->
                                                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                                                <!-- JUGADORES -->
                                                <Border Grid.Column="1"
                        Background="#22000000"
                        CornerRadius="8"
                        Padding="8,2"
                        VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding NumPlayers}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                                                </Border>

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel  Grid.Row="1" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding LeagueReadyMessage}"
           FontSize="18"
           FontWeight="SemiBold"
           HorizontalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIncompleteTeams}" Value="True">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>
                    <Button Content="Iniciar Liga"
                        Style="{StaticResource ThirdButtonStyle}"
                        FontSize="30"
                        FontWeight="Bold"
                        Height="130"
                        Width="400"
                        Command="{Binding StartLeagueCommand}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- ===================== -->
        <!-- IN PROGRESS -->
        <!-- ===================== -->
        <DataTemplate x:Key="InProgressTemplate">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>
                <!-- ===================== -->
                <!-- STANDINGS -->
                <!-- ===================== -->
                <controls:LoadingContainer Grid.Column="0"
                           IsLoading="{Binding IsLoading}">

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Clasificación"  Margin="10,0"
                            FontSize="22"
                            FontWeight="Bold" />
                        <ScrollViewer Grid.Row="1" Padding="0,0,3,0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding GroupedStandings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
         BorderBrush="{StaticResource SidebarHoverBrush}"
         BorderThickness="1"
         Padding="10"
         Margin="0,4"
         Background="{StaticResource BackgroundWindowBrush}">
                                            <StackPanel>
                                                <!-- Nombre del grupo -->
                                                <TextBlock Text="{Binding GroupName}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>
                                                <!-- 🔹 HEADER -->
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="#" FontWeight="Bold" Foreground="Gray"/>
                                                    <TextBlock Grid.Column="1" Text="Equipo" FontWeight="Bold" Foreground="Gray"/>
                                                    <TextBlock Grid.Column="2" Text="PJ" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="PG" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="PE" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="PP" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="Pts" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,5"/>
                                                <!-- 🔹 FILAS -->
                                                <ItemsControl ItemsSource="{Binding Standings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Posición -->
                                                                <TextBlock Text="{Binding Position}" FontWeight="Bold"/>
                                                                <!-- Equipo -->
                                                                <TextBlock Grid.Column="1"  Text="{Binding TeamName}" Margin="5,0"/>
                                                                <!-- Stats -->
                                                                <TextBlock Grid.Column="2" Text="{Binding Played}" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Won}" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding Draw}" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding Lost}" HorizontalAlignment="Center"/>
                                                                <!-- Puntos -->
                                                                <TextBlock Grid.Column="6" Text="{Binding Points}"  HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </controls:LoadingContainer>
                <controls:LoadingContainer  Grid.Column="2" IsLoading="{Binding IsLoading}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentMatchdayName}"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="10,0"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding NextMatches}" ScrollViewer.CanContentScroll="False"
                          SelectedItem="{Binding SelectedMatch}"
                          Background="Transparent"
                          BorderThickness="0" 
                          MouseDoubleClick="MatchesList_MouseDoubleClick" Padding="0,0,3,0"
                          >
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="rowCard"
                            CornerRadius="10"
                            BorderBrush="{StaticResource SidebarHoverBrush}"
                            BorderThickness="1"
                            Background="{StaticResource BackgroundWindowBrush}"
                            Padding="5">
                                        <StackPanel>
                                            <!-- 🔹 Equipos + marcador -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Home -->
                                                <TextBlock Text="{Binding HomeTeamName}"
                                               HorizontalAlignment="Right" FontSize="16"
                                               FontWeight="SemiBold"/>
                                                <!-- Marcador -->
                                                <TextBlock Grid.Column="1" FontSize="18"
                                               Text="{Binding ScoreDisplay}"
                                               Margin="10,0"
                                               FontWeight="Bold"/>
                                                <!-- Away -->
                                                <TextBlock Grid.Column="2" FontSize="16"
                                               Text="{Binding AwayTeamName}"
                                               HorizontalAlignment="Left"
                                               FontWeight="SemiBold"/>
                                            </Grid>
                                            <!-- 🔹 Fecha y lugar -->
                                            <StackPanel Orientation="Horizontal"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center">
                                                <!-- Fecha -->
                                                <TextBlock Text="{Binding DateDisplay}"
                       Foreground="Gray"
                       FontSize="14"/>
                                                <!-- Separador (solo si hay location) -->
                                                <TextBlock Text="   "
                       FontSize="14"/>
                                                <!-- Lugar -->
                                                <TextBlock Text="{Binding LocationDisplay}"
                       Foreground="Gray"
                       FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Hover -->
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter TargetName="rowCard" Property="BorderBrush" Value="#1ABC9C"/>
                                        </DataTrigger>
                                        <!-- Selected -->
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter TargetName="rowCard" Property="BorderBrush" Value="#1ABC9C"/>
                                            <Setter TargetName="rowCard" Property="Background" Value="#F8FDFC"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:LoadingContainer>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                <controls:LoadingContainer  Grid.Row="0" IsLoading="{Binding IsLoading}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                            <TextBlock Text="Top 5" FontSize="22" FontWeight="Bold"  Margin="10,0"/>
                        <Border CornerRadius="10" Grid.Row="1"
                                BorderBrush="{StaticResource SidebarHoverBrush}"
                                BorderThickness="1"
                                Padding="10"
                                Background="{StaticResource BackgroundWindowBrush}">
                              
                                    <StackPanel>
                                        <TextBlock Text="Goleadores" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <!-- HEADER -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="#" FontWeight="Bold" Foreground="Gray"/>
                                            <TextBlock Grid.Column="1" Text="Nombre" FontWeight="Bold" Foreground="Gray"/>
                                            <TextBlock Grid.Column="2" Text="Equipo" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Goles" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,5"/>
                                        <!-- FILAS -->
                                        <ItemsControl ItemsSource="{Binding TopScorers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="30"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Position}" FontWeight="Bold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Margin="5,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TeamName}" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Goals}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                         
                            </Border>
                        <Border CornerRadius="10" Grid.Row="2" 
                            BorderBrush="{StaticResource SidebarHoverBrush}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,4"
                            Background="{StaticResource BackgroundWindowBrush}">
                            <StackPanel>
                                <TextBlock Text="Amarillas" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <!-- HEADER -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Nombre" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="Equipo" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="T. A." FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,5"/>
                                <!-- FILAS -->
                                <ItemsControl ItemsSource="{Binding YellowCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Position}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Margin="5,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TeamName}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding YellowCards}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Grid.Row="3"
        BorderBrush="{StaticResource SidebarHoverBrush}"
        BorderThickness="1"
        Padding="10"
        Margin="0,4"
        Background="{StaticResource BackgroundWindowBrush}">
                            <StackPanel>
                                <TextBlock Text="Rojas" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <!-- HEADER -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Nombre" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="Equipo" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="T. R." FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,5"/>
                                <!-- FILAS -->
                                <ItemsControl ItemsSource="{Binding RedCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Position}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PlayerName}" Margin="5,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TeamName}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding RedCards}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:LoadingContainer>

                    <Grid Grid.Row="1">
                        <oxy:PlotView Model="{Binding DonutModel}"  Controller="{x:Null}" IsEnabled="False"
                                      Visibility="{Binding ShowDonut, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Summary.PercentagePaid, StringFormat='{}{0}%'}"
               FontSize="17" FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" Visibility="{Binding ShowDonut, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>


                </Grid>
            </Grid>
        </DataTemplate>
        <!-- ===================== -->
        <!-- PLAYOFFS -->
        <!-- ===================== -->
        <DataTemplate x:Key="PlayoffsTemplate">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Fase de Liguilla"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Aquí irá el bracket próximamente..."
                           Foreground="Gray"
                           FontStyle="Italic"/>
            </StackPanel>
        </DataTemplate>
        <!-- ===================== -->
        <!-- FINISHED -->
        <!-- ===================== -->
        <DataTemplate x:Key="FinishedTemplate">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🏆 Campeón"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryGreenBrush}"/>
                <TextBlock Text="{Binding ChampionName}"
                           FontSize="20"
                           Margin="0,10"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </DataTemplate>
        
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TÍTULO -->
        <TextBlock Text="Panel Central"
                   FontSize="26"
                   FontWeight="Bold"/>
        <!-- RESUMEN -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,15,0,10">
            <Border Style="{StaticResource CardStyle}" Width="200">
                <TextBlock Text="{Binding TotalTeams, StringFormat=Equipos: {0}}" FontSize="16"
                           FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding TotalGroups, StringFormat=Grupos: {0}}" FontSize="16"
                           FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding MinPlayers, StringFormat=Minimo de jugadores por equipo: {0}}" FontSize="16"
               FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding LeagueStatus, Converter={StaticResource LeagueStatusConverter}}" FontSize="16"
                           FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
        <!-- CONTENIDO DINÁMICO -->
        <ContentControl Grid.Row="2" Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource DefaultTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LeagueStatus}" Value="Upcoming">
                            <Setter Property="ContentTemplate" Value="{StaticResource UpcomingTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LeagueStatus}" Value="InProgress">
                            <Setter Property="ContentTemplate" Value="{StaticResource InProgressTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LeagueStatus}" Value="Playoffs">
                            <Setter Property="ContentTemplate" Value="{StaticResource PlayoffsTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LeagueStatus}" Value="Finished">
                            <Setter Property="ContentTemplate" Value="{StaticResource FinishedTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>