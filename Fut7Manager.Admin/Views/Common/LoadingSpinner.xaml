<UserControl x:Class="Fut7Manager.Admin.Views.Common.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fut7Manager.Admin.Views.Common"
             mc:Ignorable="d" 
             x:Name="root"
             Width="40" Height="40">
    <Grid>
        <Canvas Width="{Binding ActualWidth, ElementName=root}"
                Height="{Binding ActualHeight, ElementName=root}">

            <!-- Círculo base -->
            <Ellipse Width="{Binding ActualWidth, ElementName=root}"
                     Height="{Binding ActualHeight, ElementName=root}"
                     Stroke="{Binding TrackBrush, ElementName=root}"
                     StrokeThickness="{Binding Thickness, ElementName=root}"/>

            <!-- Arco animado -->
            <Path Stroke="{Binding SpinnerBrush, ElementName=root}"
                  StrokeThickness="{Binding Thickness, ElementName=root}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">

                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="20,2">
                            <ArcSegment Point="20,38"
                                        Size="18,18"
                                        SweepDirection="Clockwise"
                                        IsLargeArc="True"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>

                <Path.RenderTransform>
                    <RotateTransform x:Name="rotate"
                                     CenterX="{Binding ActualWidth, ElementName=root, Converter={StaticResource HalfConverter}}"
                                     CenterY="{Binding ActualHeight, ElementName=root, Converter={StaticResource HalfConverter}}"/>
                </Path.RenderTransform>

                <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetName="rotate"
                                    Storyboard.TargetProperty="Angle"
                                    From="0" To="360"
                                    Duration="0:0:1.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>

            </Path>

        </Canvas>
    </Grid>
</UserControl>
