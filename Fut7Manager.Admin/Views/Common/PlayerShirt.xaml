<UserControl x:Class="Fut7Manager.Admin.Views.Common.PlayerShirt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox Stretch="Uniform">

        <Grid>

            <!-- CAMISETA PRINCIPAL -->
            <Path Data="M10,0
            L24,0
            L30,4
            L34,12
            L28,16
            L28,35
            L6,35
            L6,16
            L0,12
            L4,4
            Z"
      Fill="{Binding ShirtColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Stroke="Black"
      StrokeThickness="0.6"/>

            <!-- MANGAS (refuerzo visual) -->
            <Path Data="M0,12 L6,16 L6,8 Z"
      Fill="{Binding ShirtColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Stroke="Black"
      StrokeThickness="0.4"/>

            <Path Data="M34,12 L28,16 L28,8 Z"
      Fill="{Binding ShirtColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Stroke="Black"
      StrokeThickness="0.4"/>

            <!-- CUELLO V -->
            <Path Data="M14,0 L20,0 L22,4 L17,8 L12,4 Z"
      Fill="White"
      Stroke="Black"
      StrokeThickness="0.4"/>

            <!-- NÚMERO -->
            <Grid HorizontalAlignment="Center"
      VerticalAlignment="Center">

                <TextBlock Text="{Binding JerseyNumber, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding NumberBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="Bold"
               FontSize="13"
               HorizontalAlignment="Stretch"/>

            </Grid>

        </Grid>

    </Viewbox>

</UserControl>