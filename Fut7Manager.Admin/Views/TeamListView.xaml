<UserControl x:Class="Fut7Manager.Admin.Views.TeamListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="clr-namespace:Fut7Manager.Admin.Controls"
	xmlns:conv="clr-namespace:Fut7Manager.Admin.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             d:Background="White">
    <UserControl.Resources>
        <conv:SafeImageConverter x:Key="SafeImageConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
    </UserControl.Resources>
    <Grid>
        <!-- Layout: contenido + barra inferior -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ===================== -->
        <!-- LISTA DE EQUIPOS -->
        <!-- ===================== -->
        <controls:LoadingContainer  Grid.Column="2" IsLoading="{Binding IsLoading}">
            <Grid Grid.Row="0" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock 
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                       Text="Equipos de la liga"
                       FontSize="24"
                       FontWeight="Bold"/>
                    <!-- Botón flotante para agregar equipo -->
                    <Button Style="{StaticResource IconFloatingButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding CreateTeamCommand}"
                    Content="{StaticResource IconPlus}"
                    IsEnabled="{Binding CanEditTeamInfo}"
                    Width="50"
                            ToolTip="{Binding CreateTeamTooltip}"  ToolTipService.ShowOnDisabled="True"
                    Height="50"></Button>
                </Grid>
                <ListView Grid.Row="1"
                      x:Name="TeamsList"
                      ItemsSource="{Binding Teams}"
                      SelectedItem="{Binding SelectedTeam}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      MouseDoubleClick="TeamsList_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rowCard"
                                CornerRadius="10"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                Background="White"
                                Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="9*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icono del equipo -->
                                    <Grid Width="50"
      Height="50"
      VerticalAlignment="Center">
                                        <!-- Fondo -->
                                        <Ellipse Fill="Transparent"/>
                                        <!-- Imagen circular -->
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding LogoUrl, Converter={StaticResource SafeImageConverter}}"
                        Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                            <!-- Ocultar si no hay imagen -->
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <!-- Fallback -->
                                        <TextBlock Text="🛡️" FontSize="30"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{StaticResource SidebarHoverBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Informacion -->
                                    <Grid Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="18"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TeamManagerName}" VerticalAlignment="Center"
                                               FontSize="16"
                                               />
                                        <TextBlock Grid.Column="2" Text="{Binding TeamManagerPhone}" VerticalAlignment="Center"
                                               FontSize="16"
                                               />
                                    </Grid>
                                    <!-- Indicador de estado de pago -->
                                    <Ellipse Grid.Column="2"
                                         Width="24"
                                         Height="24"
                                         VerticalAlignment="Center"
                                         Margin="8,0,0,0">
                                        <Ellipse.ToolTip>
                                            <ToolTip Style="{StaticResource DarkModernToolTipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Paid, StringFormat=Pagado: ${0:N2}}" Foreground="{StaticResource PrimaryGreenBrush}"/>
                                                    <TextBlock Text="{Binding Remaining, StringFormat=Restante: ${0:N2}}" Foreground="{StaticResource PrimaryRedBrush}"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Ellipse.ToolTip>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                        <Setter Property="Fill" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                        <Setter Property="Fill" Value="#F1C40F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Due">
                                                        <Setter Property="Fill" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="rowCard" Property="BorderBrush" Value="#1ABC9C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="rowCard" Property="BorderBrush" Value="#1ABC9C"/>
                                    <Setter TargetName="rowCard" Property="Background" Value="#F8FDFC"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </controls:LoadingContainer>
        <!-- ===================== -->
        <!-- BARRA INFERIOR CRUD -->
        <!-- ===================== -->
        <Border Grid.Row="1"
                Background="{StaticResource SidebarPressedBrush}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#AAAAAA"
                           Text="Doble click para seleccionar el equipo"/>
                <StackPanel Grid.Column="1" Height="30" Orientation="Horizontal">
                    <Button Content="Seleccionar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenTeamCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Editar"
                            Style="{StaticResource ThirdButtonStyle}"
                            Command="{Binding EditTeamCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Pagos"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenPaymentsCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Eliminar"
                            Style="{StaticResource DeleteButtonStyle}"
                            Command="{Binding DeleteTeamCommand}"
                            IsEnabled="{Binding CanEditTeamInfo}"
                            ToolTip="{Binding CreateTeamTooltip}"  
                            ToolTipService.ShowOnDisabled="True"
                            Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>