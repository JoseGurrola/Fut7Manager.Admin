<UserControl x:Class="Fut7Manager.Admin.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <DataGrid ItemsSource="{Binding Matches}"
               AutoGenerateColumns="False"
               IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Local" Binding="{Binding HomeTeamName}" Width="*"/>
                <DataGridTextColumn Header="" Binding="{Binding HomeGoals}" Width="*"/>
                <DataGridTextColumn Header="" Binding="{Binding AwayGoals}" Width="*"/>
                <DataGridTextColumn Header="Visitante" Binding="{Binding AwayTeamName}" Width="*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding MatchDate}" Width="*"/>
                <DataGridTextColumn Header="Lugar" Binding="{Binding Location}" Width="*"/>
                <DataGridTextColumn Header="Liga" Binding="{Binding LeagueId}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
