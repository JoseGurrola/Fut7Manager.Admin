<UserControl x:Class="Fut7Manager.Admin.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <DataGrid ItemsSource="{Binding Teams}"
          AutoGenerateColumns="False"
          IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Logo" Binding="{Binding LogoUrl}" Width="*"/>
                <DataGridTextColumn Header="Posición" Binding="{Binding PositionTable}" Width="*"/>
                <DataGridTextColumn Header="Puntos" Binding="{Binding Points}" Width="*"/>
                <DataGridTextColumn Header="GF" Binding="{Binding GoalsFor}" Width="*"/>
                <DataGridTextColumn Header="GC" Binding="{Binding GoalsAgainst}" Width="*"/>
                <DataGridTextColumn Header="Liga" Binding="{Binding LeagueId}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</UserControl>