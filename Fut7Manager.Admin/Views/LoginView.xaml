<UserControl x:Class="Fut7Manager.Admin.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">

        <TextBlock Text="Login" FontSize="20" Margin="0,0,0,20"/>

        <StackPanel>

            <TextBlock Text="Usuario"/>
            <TextBox Text="{Binding Username}" Margin="0,5"/>

            <TextBlock Text="Contraseña"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5"/>

        </StackPanel>

        <Button Content="Login"
                Command="{Binding LoginCommand}"
                Margin="0,10"/>

    </StackPanel>
</UserControl>