<UserControl x:Class="Fut7Manager.Admin.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fut7Manager.Admin.Converters"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:LoginButtonTextConverter x:Key="LoginButtonTextConverter"/>
    </UserControl.Resources>

    <Grid Background="#ECF0F1">
        <Border Background="White"
                Padding="30"
                CornerRadius="6"
                Width="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MinHeight="300">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Iniciar sesión"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Usuario"/>
                <TextBox Grid.Row="2" Style="{StaticResource ModernTextBoxLoginStyle}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Text="Contraseña" Margin="0,10,0,0"/>
                <PasswordBox Grid.Row="4" x:Name="PasswordBox"
                             Style="{StaticResource ModernPasswordBoxStyle}"/>

                <Button Grid.Row="5" Margin="0,20,0,0"
                        Padding="10"
                        Height="40"
                        Style="{StaticResource LoginButtonStyle}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                    <TextBlock Text="{Binding IsLoading, Converter={StaticResource LoginButtonTextConverter}}"/>
                </Button>

                <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>