<UserControl x:Class="Fut7Manager.Admin.Views.LeagueSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             d:Background="White">

    <Grid>

        <!-- Layout: contenido + barra inferior -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- LISTA DE LIGAS -->
        <!-- ===================== -->
        <Grid Grid.Row="0" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       VerticalAlignment="Center"
                       Text="Selecciona una liga"
                       FontSize="24"
                       FontWeight="Bold"/>

            <ListBox Grid.Row="1"
                     Style="{StaticResource CardListBoxStyle}"
                     ItemsSource="{Binding Leagues}"
                     SelectedItem="{Binding SelectedLeague}"
                     ItemTemplate="{StaticResource LeagueCardTemplate}"
                     MouseDoubleClick="LeaguesList_MouseDoubleClick"/>
        </Grid>

        <!-- ===================== -->
        <!-- BARRA INFERIOR CRUD -->
        <!-- ===================== -->
        <Border Grid.Row="1"
                Background="{StaticResource SidebarPressedBrush}"
                Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="#AAAAAA"
                           Text="Doble click para seleccionar la liga"/>

                <StackPanel Grid.Column="1" Height="30" Orientation="Horizontal">

                    <Button Content="Seleccionar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenLeagueCommand}"
                            Margin="0,0,10,0"/>

                    <Button Content="Editar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditLeagueCommand}"
                            Margin="0,0,10,0"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource DeleteButtonStyle}"
                            Command="{Binding DeleteLeagueCommand}"
                             Margin="0,0,10,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <Button Style="{StaticResource IconFloatingButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Command="{Binding CreateLeagueCommand}"
                Content="{StaticResource IconPlus}">

            <Button.ToolTip>
                <ToolTip Style="{StaticResource DarkModernToolTipStyle}" Content="Agregar liga"/>
            </Button.ToolTip>

        </Button>

    </Grid>
</UserControl>
