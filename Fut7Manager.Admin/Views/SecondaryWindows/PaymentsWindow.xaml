<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.PaymentsWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="Pagos"
     Width="420"
     Height="550"
     WindowStartupLocation="CenterScreen"
     ResizeMode="NoResize"
     WindowStyle="None"
     AllowsTransparency="True"
     Background="Transparent">
    <Border CornerRadius="12"
        Background="White"
        BorderThickness="1"
        BorderBrush="Gray">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15*"/>
             
            </Grid.RowDefinitions>

            <!-- Nombre del equipo -->
            <TextBlock Grid.Row="0"
                   Text="{Binding TeamName}"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" FontSize="18"
                   Text="Historial de pagos"
                   FontWeight="SemiBold"
                   Margin="0,10,0,5"/>

            <Grid Grid.Row="2" Margin="5,0,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Fecha" FontWeight="Bold" FontSize="14"/>
                <TextBlock Grid.Column="1" Text="Monto" FontWeight="Bold" FontSize="14"/>
                
            </Grid>
            <!-- Historial -->
            <ListView Grid.Row="3" ScrollViewer.VerticalScrollBarVisibility="Hidden"
       ItemsSource="{Binding Payments}"
       BorderThickness="0"
       Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="rowCard" 
                CornerRadius="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Background="White"
                Padding="10,0,0,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fecha -->
                                <TextBlock Grid.Column="0"
                           Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                                <!-- Monto -->
                                <TextBlock Grid.Column="1"
                           Text="{Binding Amount, StringFormat=${0:N2}}"
                           VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="{StaticResource SecondaryGreenBrush}"/>

                                <!-- Botón eliminar -->
                                <Button Grid.Column="2" 
                        Content="Eliminar" Height="30"
                        Style="{StaticResource DeleteButtonStyle}"
                        Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter TargetName="rowCard" Property="BorderBrush" Value="#1ABC9C"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Separator Grid.Row="4"/>
            <!-- Nuevo pago  y cancelar -->
            <StackPanel Grid.Row="5"
                    Orientation="Horizontal">
                <TextBox Width="150" 
                     Style="{StaticResource CurrencyTextBoxStyle}"
                     Text="{Binding NewAmount}"
                     VerticalContentAlignment="Center"
                     />
                <Button Content="Registrar" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddPaymentCommand}"/>
                <Button Grid.Row="4" HorizontalAlignment="Left"
                    Content="Cerrar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100"
                    Command="{Binding CloseCommand}"/>
            </StackPanel>

            
        </Grid>
    </Border>
</Window>
