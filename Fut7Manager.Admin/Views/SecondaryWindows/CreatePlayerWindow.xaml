<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.CreatePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows"
        mc:Ignorable="d"
        Title="Crear jugador"
        Width="400"
        Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="12"
            Background="White"
            BorderBrush="Gray"
            BorderThickness="1">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nombre -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nombre"/>
                <TextBlock Text=" *" Foreground="Red"/>
            </StackPanel>
            <TextBox Grid.Row="1" 
                     Text="{Binding Name}"
                     Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Número -->
            <TextBlock Grid.Row="2" Text="Número"/>
            <TextBox Grid.Row="3"
                     Text="{Binding JerseyNumber}"
                     Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Teléfono -->
            <TextBlock Grid.Row="4" Text="Teléfono"/>
            <TextBox Grid.Row="5"
                     Text="{Binding Phone}"
                     Style="{StaticResource TelephoneTextBoxStyle}"/>
<!--fecha de nacimiento -->
            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <TextBlock Text="Fecha de nacimiento"/>
            </StackPanel>

            <TextBox Grid.Row="7"
         Text="{Binding DateOfBirthString}"
         Style="{StaticResource ModernTextBoxStyle}"
         ToolTip="Formato: YYYY-MM-DD"/>
            
            <!-- Posición -->
            <TextBlock Grid.Row="8" Text="Posición"/>
            <ComboBox Grid.Row="9"
          ItemsSource="{Binding Positions}"
          SelectedValue="{Binding Position}"
          SelectedValuePath="Value"
          Style="{StaticResource ModernComboBoxStyle}"
          Height="40">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <!-- Equipo -->
            <StackPanel Grid.Row="10" Orientation="Horizontal">
                <TextBlock Text="Equipo"/>
                <TextBlock Text=" *" Foreground="Red"/>
            </StackPanel>
            <ComboBox Grid.Row="11"
          ItemsSource="{Binding Teams}"
          SelectedValuePath="Id"
          SelectedValue="{Binding SelectedTeamId}"
          Style="{StaticResource ModernComboBoxStyle}"
          Height="40">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <!-- Activo -->
            <CheckBox Grid.Row="12"
                      Content="Jugador activo"
                      IsChecked="{Binding Active}"
                      Margin="0,10,0,0"/>

            <!-- Botones -->
            <StackPanel Grid.Row="13" Height="40"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                <Button Content="Cancelar" Width="90" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Guardar" Width="90" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
