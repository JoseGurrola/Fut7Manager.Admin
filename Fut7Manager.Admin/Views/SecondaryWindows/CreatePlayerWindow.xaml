<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.CreatePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows" xmlns:local1="clr-namespace:Fut7Manager.Admin.Helpers"
        xmlns:common="clr-namespace:Fut7Manager.Admin.Views.Common"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Crear jugador"
        Width="400"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="12"
            Background="White"
            BorderBrush="Gray"
            BorderThickness="1">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><!-- Teléfono -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nombre -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nombre"/>
                <TextBlock Text=" *" Foreground="Red"/>
            </StackPanel>
            <TextBox Grid.Row="1" 
                     Text="{Binding Name}"
                     Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Número -->
            <TextBlock Grid.Row="2" Text="Número"/>
            <TextBox Grid.Row="3"
                     Text="{Binding JerseyNumber}"
                     Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Teléfono -->
            <TextBlock Grid.Row="4" Text="Teléfono"/>
            <TextBox Grid.Row="5"
                     Text="{Binding Phone}"
                     Style="{StaticResource TelephoneTextBoxStyle}"/>
            <!-- Email -->
            <TextBlock Grid.Row="6" Text="Correo"/>
            <TextBox Grid.Row="7"
                Style="{StaticResource EmailTextBoxStyle}">
                <TextBox.Text>
                    <Binding Path="Email"
             UpdateSourceTrigger="PropertyChanged"
             ValidatesOnDataErrors="True">
                        <Binding.ValidationRules>
                            <local1:EmailValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <TextBox.ToolTip>
                    <ToolTip>
                        <TextBlock Text="Si ingresas correo, debe ser válido (ej: usuario@dominio.com)"/>
                    </ToolTip>
                </TextBox.ToolTip>
            </TextBox>
            <!--fecha de nacimiento -->
            <StackPanel Grid.Row="8" Orientation="Horizontal">
                <TextBlock Text="Fecha de nacimiento"/>
            </StackPanel>

            <!--<TextBox Grid.Row="9"
         Text="{Binding DateOfBirthString}"
         Style="{StaticResource ModernTextBoxStyle}"
         ToolTip="Formato: YYYY-MM-DD"/>-->
            <DatePicker Grid.Row="9"
            Style="{StaticResource ModernDatePickerStyle}"
            DisplayDateEnd="{x:Static sys:DateTime.Today}"
            SelectedDate="{Binding DateOfBirth, Mode=TwoWay}"
            Height="42"/>
            
            
            <!-- Posición -->
            <TextBlock Grid.Row="10" Text="Posición"/>
            <ComboBox Grid.Row="11"
          ItemsSource="{Binding Positions}"
          SelectedValue="{Binding Position}"
          SelectedValuePath="Value"
          Style="{StaticResource ModernComboBoxStyle}"
          Height="40">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <!-- Equipo -->
            <StackPanel Grid.Row="12" Orientation="Horizontal">
                <TextBlock Text="Equipo"/>
                <TextBlock Text=" *" Foreground="Red"/>
            </StackPanel>
            <ComboBox Grid.Row="13"
          ItemsSource="{Binding Teams}"
          SelectedValuePath="Id"
          SelectedValue="{Binding SelectedTeamId}"
          Style="{StaticResource ModernComboBoxStyle}"
          Height="40">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <!-- Activo -->
           <!-- <CheckBox Grid.Row="14"
                      Content="Jugador activo"
                      IsChecked="{Binding Active}"
                      Margin="0,10,0,0"/>-->
            

            <!-- Botones -->
            <Grid Grid.Row="14" Height="50" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Activo" FontSize="10" HorizontalAlignment="Center" />
                    <common:FloatingToggleSwitch  
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" 
                        IsChecked="{Binding Active, Mode=TwoWay, 
                        UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Cancelar" Width="90" Margin="8,0,0,0" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>

                <Button Grid.Column="2" Content="Guardar" Width="90" Margin="8,0,0,0" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </Grid>

        </Grid>
    </Border>
</Window>
