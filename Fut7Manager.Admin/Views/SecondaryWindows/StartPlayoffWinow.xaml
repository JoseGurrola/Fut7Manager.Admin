<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.StartPlayoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows" 
         xmlns:controls="clr-namespace:Fut7Manager.Admin.Controls"
        xmlns:common="clr-namespace:Fut7Manager.Admin.Views.Common"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Height="700"
        Width="1100"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ========================= -->
        <!-- CLASIFICADOS -->
        <!-- ========================= -->
        <DataTemplate x:Key="TeamsTemplate">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Configuración de Liguilla"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="(Arrastra equipos entre listas)"
                               FontSize="14"
                               Margin="0,5,0,20"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- CLASIFICADOS -->
                    <Border 
                            Padding="10"
                            BorderBrush="{StaticResource SidebarHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Text="Clasificados"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>
                            <ListBox
    Grid.Row="1"
    ItemsSource="{Binding QualifiedTeams}"
    AllowDrop="True"
    PreviewMouseMove="ListBox_PreviewMouseMove"
    Drop="Qualified_Drop"
    Background="Transparent"
    BorderThickness="0"
    ScrollViewer.VerticalScrollBarVisibility="Auto"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.CanContentScroll="False">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2,4,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border x:Name="rowCard"
                    Margin="2"
                    Padding="6"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Background="{StaticResource BackgroundWindowBrush}">

                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="1"
                                      Opacity="0.10"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LOGO -->
                                                <Grid Grid.Column="0"
                          Width="40"
                          Height="40"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">

                                                    <Rectangle Fill="Transparent"/>

                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding LogoUrl, Converter={StaticResource SafeImageConverter}}"
                                            Stretch="Uniform"/>
                                                        </Rectangle.Fill>

                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <TextBlock Text="🛡️"
                                   FontSize="28"
                                   Foreground="{StaticResource SidebarHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </Grid>

                                                <!-- INFO -->
                                                <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Points}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" pts" FontSize="14" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding GroupName}"
                                   FontSize="12"
                                   Foreground="Gray"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                        <DataTemplate.Triggers>

                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">

                                                <Setter TargetName="rowCard"
                            Property="BorderBrush"
                            Value="#1ABC9C"/>

                                                <Setter TargetName="rowCard"
                            Property="Background"
                            Value="#F8FDFC"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">

                                                <Setter TargetName="rowCard"
                            Property="BorderBrush"
                            Value="#1ABC9C"/>

                                                <Setter TargetName="rowCard"
                            Property="BorderThickness"
                            Value="2"/>

                                                <Setter TargetName="rowCard"
                            Property="Background"
                            Value="#F8FDFC"/>

                                            </DataTrigger>

                                        </DataTemplate.Triggers>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                        </Grid>

                    </Border>
                    <!-- ELIMINADOS -->
                    <Border Grid.Column="2"
        Padding="10"
        BorderBrush="{StaticResource SidebarHoverBrush}"
        BorderThickness="1"
        CornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Eliminados"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                            <ListBox
    Grid.Row="1"
    ItemsSource="{Binding EliminatedTeams}"
    AllowDrop="True"
    PreviewMouseMove="ListBox_PreviewMouseMove"
    Drop="Eliminated_Drop"
    Background="Transparent"
    BorderThickness="0"
    ScrollViewer.VerticalScrollBarVisibility="Auto"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.CanContentScroll="False">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2,4,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border x:Name="rowCard"
                    Margin="2"
                    Padding="6"
                    CornerRadius="8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Background="{StaticResource BackgroundWindowBrush}">

                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="1"
                                      Opacity="0.10"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LOGO -->
                                                <Grid Grid.Column="0"
                          Width="40"
                          Height="40"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">

                                                    <Rectangle Fill="Transparent"/>

                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding LogoUrl, Converter={StaticResource SafeImageConverter}}"
                                            Stretch="Uniform"/>
                                                        </Rectangle.Fill>

                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <TextBlock Text="🛡️"
                                   FontSize="28"
                                   Foreground="{StaticResource SidebarHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LogoUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </Grid>

                                                <!-- INFO -->
                                                <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Points}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" pts" FontSize="14" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding GroupName}"
                                   FontSize="12"
                                   Foreground="Gray"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                        <DataTemplate.Triggers>

                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">

                                                <Setter TargetName="rowCard"
                            Property="BorderBrush"
                            Value="#1ABC9C"/>

                                                <Setter TargetName="rowCard"
                            Property="Background"
                            Value="#F8FDFC"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">

                                                <Setter TargetName="rowCard"
                            Property="BorderBrush"
                            Value="#1ABC9C"/>

                                                <Setter TargetName="rowCard"
                            Property="BorderThickness"
                            Value="2"/>

                                                <Setter TargetName="rowCard"
                            Property="Background"
                            Value="#F8FDFC"/>

                                            </DataTrigger>

                                        </DataTemplate.Triggers>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DeleteButtonStyle}"
                            Height="40"/>

                    <Button Grid.Column="1"
                            Content="Siguiente"
                            Command="{Binding NextCommand}"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40"/>

                </Grid>

            </Grid>

        </DataTemplate>

        <!-- ========================= -->
        <!-- ENFRENTAMIENTOS -->
        <!-- ========================= -->

        <DataTemplate x:Key="MatchupsTemplate">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titulo -->
                <StackPanel>

                    <TextBlock Text="Configuración de Liguilla"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Revisa los enfrentamientos generados"
                       FontSize="14"
                       Margin="0,5,0,20"
                       HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- BRACKET -->
                <ScrollViewer Grid.Row="1"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">

                    <Grid VerticalAlignment="Top">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= LEFT ================= -->

                        <ItemsControl Grid.Column="0"
                      ItemsSource="{Binding LeftRounds}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="{Binding RoundMargin}">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Matches}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Width="170"
                                            Height="85"
                                            Margin="{Binding MatchMargin}"
                                            Padding="6"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource SidebarHoverBrush}"
                                            Background="{StaticResource BackgroundWindowBrush}">

                                                        <Grid>

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Image Width="20"
                                                       Height="20"
                                                       Source="{Binding HomeTeam.LogoUrl, Converter={StaticResource SafeImageConverter}}"/>

                                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding HomeTeam.Name, TargetNullValue=TBD}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                                <TextBlock Grid.Column="2"
                                                           Text="-"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                            </Grid>

                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Image Width="20"
                                                       Height="20"
                                                       Source="{Binding AwayTeam.LogoUrl, Converter={StaticResource SafeImageConverter}}"/>

                                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding AwayTeam.Name, TargetNullValue=TBD}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                                <TextBlock Grid.Column="2"
                                                           Text="-"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                            </Grid>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- ================= FINAL ================= -->

                        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                            <TextBlock Text="{Binding FinalRound.Name, TargetNullValue=Final}"
                       FontWeight="Bold"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                            <ItemsControl ItemsSource="{Binding FinalRound.Matches}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Width="180"
                                Height="90"
                                Padding="6"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="Gold"
                                Background="{StaticResource BackgroundWindowBrush}">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding HomeTeam.Name, TargetNullValue=TBD}"
                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="1"
                                           Text="{Binding AwayTeam.Name, TargetNullValue=TBD}"
                                           VerticalAlignment="Center"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                        <!-- ================= RIGHT ================= -->

                        <ItemsControl Grid.Column="2"
                      ItemsSource="{Binding RightRounds}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="{Binding RoundMargin}">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Matches}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Width="170"
                                            Height="85"
                                            Margin="{Binding MatchMargin}"
                                            Padding="6"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource SidebarHoverBrush}"
                                            Background="{StaticResource BackgroundWindowBrush}">

                                                        <Grid>

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="-"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding HomeTeam.Name, TargetNullValue=TBD}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                                <Image Grid.Column="2"
                                                       Width="20"
                                                       Height="20"
                                                       Source="{Binding HomeTeam.LogoUrl, Converter={StaticResource SafeImageConverter}}"/>

                                                            </Grid>

                                                            <Grid Grid.Row="1">

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="-"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                                <TextBlock Grid.Column="1"
                                                           Margin="5,0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding AwayTeam.Name, TargetNullValue=TBD}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                                <Image Grid.Column="2"
                                                       Width="20"
                                                       Height="20"
                                                       Source="{Binding AwayTeam.LogoUrl, Converter={StaticResource SafeImageConverter}}"/>

                                                            </Grid>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- BOTONES -->
                <Grid Grid.Row="2" Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Atrás"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DeleteButtonStyle}"
                    Height="40"/>

                    <Button Grid.Column="1"
                    Content="Iniciar Liguilla"
                    Command="{Binding FinishCommand}"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"/>

                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource BackgroundWindowBrush}"
            BorderBrush="Gray"
            BorderThickness="1">

        <ContentControl Content="{Binding}">

            <ContentControl.Style>

                <Style TargetType="ContentControl">

                    <Setter Property="ContentTemplate"
                            Value="{StaticResource TeamsTemplate}"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding CurrentStep}"
                                     Value="Matchups">

                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource MatchupsTemplate}"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ContentControl.Style>

        </ContentControl>

    </Border>
</Window>