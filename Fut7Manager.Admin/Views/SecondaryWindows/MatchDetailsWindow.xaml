<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.MatchDetailsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows"
             mc:Ignorable="d" 
            Title="Detalles del partido"
        Width="950"
        Height="800"
             WindowStartupLocation="CenterScreen"
            ResizeMode="NoResize"
            WindowStyle="None"
            AllowsTransparency="True"
           >
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Local -->
            <StackPanel Grid.Column="0">
                <!--<Grid>
                    --><!-- Imagen --><!--
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding HomeTeamLogo, Converter={StaticResource SafeImageConverter}}"
         Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeTeamLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HomeTeamLogo}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    --><!-- Fallback --><!--
                    <TextBlock Text="🛡️"
FontSize="30"
HorizontalAlignment="Center"
VerticalAlignment="Center"
Foreground="{StaticResource SidebarHoverBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeTeamLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HomeTeamLogo}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>-->
                <GroupBox Header="{Binding HomeTeamName}" FontSize="20">

                    <DataGrid
            ItemsSource="{Binding HomePlayers}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
            RowHeight="35"
                        FontSize="16"
            ColumnHeaderHeight="40"
            Margin="5">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisteredPlayer}"
                                     Value="False">
                                        <Setter Property="Background"
                                    Value="#FFF9E6"/>
                                        
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn
                    Header="N"
                    Binding="{Binding JerseyNumber}"
                    Width="50"
                    IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
 
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                    Header="Jugador"
                    Binding="{Binding PlayerName}"
                    Width="*"/>

                            <DataGridTextColumn
                    Header="{StaticResource IconLeague}" 
                    Binding="{Binding Goals}"
                    Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding YellowCards}"  Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="16" Height="24" Fill="Yellow" Stroke="Black"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding RedCards}"  Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="16" Height="24" Fill="Red" Stroke="Black"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <TextBlock FontWeight="Bold">
    <Run Text="Goles capturados: " FontSize="16"/>
    <Run Text="{Binding HomeGoalsCaptured, Mode=OneWay}"/>
    <Run Text=" / "/>
    <Run Text="{Binding HomeGoalsExpected, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontWeight="Bold"
               HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                        Value="⚠ No coincide con el marcador"/>
                            <Setter Property="Foreground"
                        Value="Red"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HomeGoalsMatch}"
                                 Value="True">
                                    <Setter Property="Text"
                                Value="✓ Correcto"/>
                                    <Setter Property="Foreground"
                                Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
            <!-- Visitante -->
            <StackPanel Grid.Column="2">
                <!-- ICON AWAY -->
                <!--<Grid>
                    --><!-- Imagen --><!--
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AwayTeamLogo, Converter={StaticResource SafeImageConverter}}"
         Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AwayTeamLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AwayTeamLogo}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    --><!-- Fallback --><!--
                    <TextBlock Text="🛡️"
FontSize="30"
HorizontalAlignment="Center"
VerticalAlignment="Center"
Foreground="{StaticResource SidebarHoverBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AwayTeamLogo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AwayTeamLogo}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>-->
       
        <GroupBox Header="{Binding AwayTeamName}" FontSize="20">

                    <DataGrid
            ItemsSource="{Binding AwayPlayers}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Visible"
            RowHeight="35"
                        FontSize="16"
ColumnHeaderHeight="40"
            Margin="5">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisteredPlayer}"
                                     Value="False">
                                        <Setter Property="Background"
                                    Value="#FFF9E6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn
                    Header="N"
                    Binding="{Binding JerseyNumber}"
                    Width="50"
                    IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                    Header="Jugador"
                    Binding="{Binding PlayerName}"
                    Width="*"/>

                            <DataGridTextColumn
                    Header="{StaticResource IconLeague}" 
                    Binding="{Binding Goals}"
                    Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding YellowCards}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="16" Height="24" Fill="Yellow" Stroke="Black"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding RedCards}"  Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="16" Height="24" Fill="Red" Stroke="Black"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <TextBlock FontWeight="Bold">
    <Run Text="Goles capturados: " FontSize="16"/>
    <Run Text="{Binding AwayGoalsCaptured, Mode=OneWay}"/>
    <Run Text=" / "/>
    <Run Text="{Binding AwayGoalsExpected, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontWeight="Bold"
               HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                        Value="⚠ No coincide con el marcador"/>
                            <Setter Property="Foreground"
                        Value="Red"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AwayGoalsMatch}"
                                 Value="True">
                                    <Setter Property="Text"
                                Value="✓ Correcto"/>
                                    <Setter Property="Foreground"
                                Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
        Width="100" Height="40"
        Command="{Binding SaveCommand}"
        IsEnabled="{Binding CanSaveDetails}"/>
        </StackPanel>
    </Grid>
</Window>
