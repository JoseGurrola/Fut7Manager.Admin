<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.GroupAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows" 
         xmlns:controls="clr-namespace:Fut7Manager.Admin.Controls"
        xmlns:common="clr-namespace:Fut7Manager.Admin.Views.Common"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Height="600"
        AllowsTransparency="True"
        Width="800"
        Background="Transparent">

    <Window.Resources>

        <DataTemplate x:Key="ConfigurationTemplate">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITULO -->
                <TextBlock Text="Configuración de liga"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,25"
                   HorizontalAlignment="Center"/>

                <!-- GRUPOS -->
                <TextBlock Grid.Row="2"
                           FontSize="16"
                   Text="Número de grupos"
                   Margin="0,0,0,5"/>

                <ComboBox Grid.Row="3" FontSize="16"
                  ItemsSource="{Binding NumberOfGroupsOptions}"
                  SelectedItem="{Binding NumberOfGroups}"
                  Style="{StaticResource ModernComboBoxStyle}"
                  Height="40"/>

                <!-- CLASIFICADOS -->
                <TextBlock Grid.Row="4" FontSize="16"
                   Text="Total de equipos que clasificarán"
                   Margin="0,15,0,5"/>

                <ComboBox Grid.Row="5" FontSize="16"
                  ItemsSource="{Binding QualifiedTeamsOptions}"
                  SelectedItem="{Binding TotalQualifiedTeams}"
                  Style="{StaticResource ModernComboBoxStyle}"
                  Height="40"/>

                <!-- BOTONES -->
                <Grid Grid.Row="7" Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Cancelar" Grid.Column="0"
                    Style="{StaticResource DeleteButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Height="40"/>

                    <Button Content="Siguiente" Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ContinueConfigurationCommand}"
                    Height="40"/>

                </Grid>

            </Grid>

        </DataTemplate>
        <!-- ===================== -->
        <!-- TEMPLATE: GRUPOS -->
        <!-- ===================== -->
        <DataTemplate x:Key="GroupsTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock  Text="Configuración de Grupos"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="(Arrastra y suelta un equipo de un grupo a otro)"
                    FontSize="14"
                    Margin="0,0,0,25"
                    HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="2"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220"
                        Margin="10"
                        Padding="10"
                        BorderBrush="{StaticResource SidebarHoverBrush}"
                        BorderThickness="1"
                        CornerRadius="10">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.3"/>
                                    </Border.Effect>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                                        <ListBox ItemsSource="{Binding Teams}"
                                 DisplayMemberPath="Name"
                                 AllowDrop="True"
                                 PreviewMouseMove="ListBox_PreviewMouseMove"
                                 Drop="ListBox_Drop"
                                 Height="200"
                                 Background="Transparent"
                                 BorderThickness="0"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>

                <Grid Grid.Row="3"
                            Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnBack" Content="Atras"
                         Style="{StaticResource DeleteButtonStyle}"
                         Command="{Binding BackCommand}"
                         Height="40" />

                    <Button Grid.Column="1" Content="Aleatorizar"
                            Style="{StaticResource ThirdButtonStyle}"
                            Command="{Binding RandomizeCommand}"
                            Height="40"
                            />

                    <Button Grid.Column="2" Content="Siguiente"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConfirmCommand}"
                            Height="40"
                            />
                </Grid>
                <!-- BOTÓN FINAL -->   
            </Grid>
        </DataTemplate>

        <!-- ===================== -->
        <!-- TEMPLATE: CALENDARIO -->
        <!-- ===================== -->
        <DataTemplate x:Key="ScheduleTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><!-- OPCIONES -->
                    <RowDefinition Height="*"/> <!-- MATCHDAYS -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock  Text="Configuración de calendario"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"/>
                <!-- OPCIONES -->
                <Grid Grid.Row="1" Margin="0,10,0,10" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!--<CheckBox Content="Permitir partidos entre grupos"
                              IsChecked="{Binding InterGroupMatches}"
                              VerticalAlignment="Center"
                             />-->
                    
                    <common:FloatingToggleSwitch VerticalAlignment="Center" HorizontalAlignment="Left"
                         IsChecked="{Binding InterGroupMatches, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    <TextBlock Margin="10" Grid.Column="1" Text="Permitir partidos entre grupos" FontSize="14" VerticalAlignment="Center"/>
                </Grid>

                <!-- MATCHDAYS -->
                <controls:LoadingContainer Grid.Row="2" IsLoading="{Binding IsLoading}">
                    <ScrollViewer >
                        <ItemsControl ItemsSource="{Binding Matchdays}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="340" 
                                        Margin="10"
                                        Padding="10"
                                        BorderBrush="{StaticResource SidebarHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                        </Border.Effect>

                                        <StackPanel>

                                            <TextBlock Text="{Binding Number, StringFormat=Jornada {0}}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>

                                            <ListBox ItemsSource="{Binding Matches}"
         Background="Transparent"
         Width="Auto"
         BorderThickness="0"
         HorizontalContentAlignment="Stretch">

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6"
                                                        Margin="2"
                                                        CornerRadius="6"
                                                        Background="{StaticResource BackgroundWindowBrush}"
                                                        BorderBrush="{StaticResource SidebarHoverBrush}"
                                                        BorderThickness="1"
                                                        >

                                                            <Grid >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="5*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="5*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Home -->
                                                                <TextBlock Text="{Binding HomeTeamName}"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Center"/>

                                                                <!-- VS -->
                                                                <TextBlock Grid.Column="1"
                                                               Text="vs"
                                                               Margin="10,0"
                                                               Foreground="Gray"
                                                               VerticalAlignment="Center"/>

                                                                <!-- Away -->
                                                                <TextBlock Grid.Column="2"
                                                               Text="{Binding AwayTeamName}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>

                                                            </Grid>

                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>

                                            </ListBox>

                                            <TextBlock Text="{Binding RestingTeamsDisplay}"
                                                   Foreground="{StaticResource SidebarHoverBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="5,8,0,0"/>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>

                </controls:LoadingContainer>
                <!-- BOTÓN FINAL -->
                <Grid Grid.Row="3"
                            Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnBack" Content="Atras"
                         Style="{StaticResource DeleteButtonStyle}"
                         Command="{Binding BackCommand}"
                         Height="40" />
                    <Button Grid.Column="1" x:Name="btnGenerateSchedule" Content="Generar calendario"
                            Style="{StaticResource ThirdButtonStyle}"
                            Command="{Binding GenerateScheduleCommand}"
                            Height="40" />
                    <Button Grid.Column="2" Content="Finalizar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding FinishCommand}"
                            Height="40"/>
                </Grid>

            </Grid>
        </DataTemplate>

    </Window.Resources>


    <!-- CONTENIDO DINÁMICO -->
    <Border CornerRadius="12"
    Background="{StaticResource BackgroundWindowBrush}"
    BorderThickness="1"
    BorderBrush="Gray">
        <Grid>

            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">

                        <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding CurrentStep}" Value="Configuration">
                                <Setter Property="ContentTemplate" Value="{StaticResource ConfigurationTemplate}"/>
                            </DataTrigger>
                            
                            <DataTrigger Binding="{Binding CurrentStep}" Value="Groups">
                                <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentStep}" Value="Schedule">
                                <Setter Property="ContentTemplate" Value="{StaticResource ScheduleTemplate}"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </Grid>
    </Border>
</Window>