<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.GroupAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows" 
        Title="Configurar Liga"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <!-- ===================== -->
    <!-- RESOURCES -->
    <!-- ===================== -->
    <Window.Resources>

        <!-- ===================== -->
        <!-- TEMPLATE: GRUPOS -->
        <!-- ===================== -->
        <DataTemplate x:Key="GroupsTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LISTA DE GRUPOS -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220"
                                    Margin="10"
                                    Padding="10"
                                    BorderBrush="#CCC"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <StackPanel>

                                    <!-- Nombre grupo -->
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <!-- Equipos -->
                                    <ListBox ItemsSource="{Binding Teams}"
                                             DisplayMemberPath="Name"
                                             AllowDrop="True"
                                             PreviewMouseMove="ListBox_PreviewMouseMove"
                                             Drop="ListBox_Drop"
                                             Height="200"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BOTONES -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Aleatorizar"
                            Command="{Binding RandomizeCommand}"
                            Margin="5"/>

                    <Button Content="Siguiente"
                            Command="{Binding ConfirmCommand}"
                            Margin="5"/>
                </StackPanel>

            </Grid>
        </DataTemplate>


        <!-- ===================== -->
        <!-- TEMPLATE: CALENDARIO -->
        <!-- ===================== -->
        <DataTemplate x:Key="ScheduleTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- OPCIONES -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Permitir partidos entre grupos"
                              IsChecked="{Binding InterGroupMatches}"
                              VerticalAlignment="Center"/>

                    <Button Content="Generar calendario"
                            Command="{Binding GenerateScheduleCommand}"
                            Margin="15,0,0,0"/>
                </StackPanel>

                <!-- MATCHDAYS -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Matchdays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250"
                                        Margin="10"
                                        Padding="10"
                                        BorderBrush="#CCC"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <StackPanel>

                                        <!-- Jornada -->
                                        <TextBlock Text="{Binding Number, StringFormat=Jornada {0}}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>

                                        <!-- Partidos -->
                                        <ListBox ItemsSource="{Binding Matches}"
                                             AllowDrop="True"
                                             PreviewMouseMove="Match_PreviewMouseMove"
                                             Drop="Match_Drop">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6"
                                                        Margin="2"
                                                        CornerRadius="6"
                                                        Background="#F5F5F5">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                            <TextBlock Text="⚽" Margin="0,0,5,0"/>

                                                            <TextBlock Text="{Binding HomeTeamName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text=" vs " Margin="5,0"/>
                                                            <TextBlock Text="{Binding AwayTeamName}" FontWeight="SemiBold"/>

                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                        <!-- DESCANSOS  -->
                                        <TextBlock Text="{Binding RestingTeamsDisplay}"
           Foreground="Gray"
           FontStyle="Italic"
           Margin="5,5,0,0"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        
                    </ItemsControl>
                </ScrollViewer>

                <!-- BOTÓN FINAL -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Finalizar"
                            Click="Close_Click"
                            Margin="5"/>
                </StackPanel>

            </Grid>
        </DataTemplate>

    </Window.Resources>


    <!-- ===================== -->
    <!-- CONTENIDO DINÁMICO -->
    <!-- ===================== -->
    <Grid>
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">

                    <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding CurrentStep}" Value="Groups">
                            <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding CurrentStep}" Value="Schedule">
                            <Setter Property="ContentTemplate" Value="{StaticResource ScheduleTemplate}"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>

</Window>