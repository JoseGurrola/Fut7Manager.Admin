<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.GroupAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fut7Manager.Admin.Views.SecondaryWindows" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Height="600"
        AllowsTransparency="True"
        Width="600"
        Background="Transparent">

    <Window.Resources>

        <!-- ===================== -->
        <!-- TEMPLATE: GRUPOS -->
        <!-- ===================== -->
        <DataTemplate x:Key="GroupsTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200"
                                    Margin="10"
                                    Padding="10"
                                    BorderBrush="{StaticResource SidebarHoverBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>

                                <StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <ListBox ItemsSource="{Binding Teams}"
                                             DisplayMemberPath="Name"
                                             AllowDrop="True"
                                             PreviewMouseMove="ListBox_PreviewMouseMove"
                                             Drop="ListBox_Drop"
                                             Height="200"
                                             Background="Transparent"
                                             BorderThickness="0"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Aleatorizar"
                            Style="{StaticResource ThirdButtonStyle}"
                            Command="{Binding RandomizeCommand}"
                            Height="40"
                            />

                    <Button Content="Siguiente"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConfirmCommand}"
                            Height="40"
                            />
                </StackPanel>

            </Grid>
        </DataTemplate>


        <!-- ===================== -->
        <!-- TEMPLATE: CALENDARIO -->
        <!-- ===================== -->
        <DataTemplate x:Key="ScheduleTemplate">
            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- OPCIONES -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Permitir partidos entre grupos"
                              IsChecked="{Binding InterGroupMatches}"
                              VerticalAlignment="Center"
                             />

                    <Button Content="Generar calendario"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GenerateScheduleCommand}"
                            Width="200"
                            Height="40"/>
                </StackPanel>

                <!-- MATCHDAYS -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Matchdays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="270"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250"
                                        Margin="10"
                                        Padding="10"
                                        BorderBrush="{StaticResource SidebarHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Number, StringFormat=Jornada {0}}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>

                                        <ListBox ItemsSource="{Binding Matches}"
                                             AllowDrop="True"
                                             PreviewMouseMove="Match_PreviewMouseMove"
                                             Drop="Match_Drop"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             HorizontalContentAlignment="Stretch">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6"
                                                        Margin="2"
                                                        CornerRadius="6"
                                                        Background="{StaticResource BackgroundWindowBrush}"
                                                        BorderBrush="{StaticResource SidebarHoverBrush}"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Stretch">  

                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Home -->
                                                            <TextBlock Text="{Binding HomeTeamName}"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Center"/>           

                                                            <!-- VS -->
                                                            <TextBlock Grid.Column="1"
                                                               Text="vs"
                                                               Margin="10,0"
                                                               Foreground="Gray"
                                                               VerticalAlignment="Center"/>

                                                            <!-- Away -->
                                                            <TextBlock Grid.Column="2"
                                                               Text="{Binding AwayTeamName}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>

                                                        </Grid>

                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                        <TextBlock Text="{Binding RestingTeamsDisplay}"
                                                   Foreground="{StaticResource SidebarHoverBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="5,8,0,0"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

                <!-- BOTÓN FINAL -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Finalizar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Close_Click"
                            Height="40"/>
                </StackPanel>

            </Grid>
        </DataTemplate>

    </Window.Resources>


    <!-- CONTENIDO DINÁMICO -->
    <Border CornerRadius="12"
    Background="White"
    BorderThickness="1"
    BorderBrush="Gray">
        <Grid>

            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">

                        <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding CurrentStep}" Value="Groups">
                                <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentStep}" Value="Schedule">
                                <Setter Property="ContentTemplate" Value="{StaticResource ScheduleTemplate}"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </Grid>
    </Border>
</Window>