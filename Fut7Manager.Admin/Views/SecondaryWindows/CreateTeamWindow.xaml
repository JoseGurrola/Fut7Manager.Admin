<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.CreateTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Crear liga"
        Width="400"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="White"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!--<RowDefinition Height="Auto"/>-->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Nombre del Equipo"/>
                    <TextBlock Text=" *" Foreground="Red"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1"  >
                    <TextBox Margin="0,0,5,0"
   Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"
   Style="{StaticResource ModernTextBoxStyle}"
   VerticalContentAlignment="Center"
   MaxLength="50"
   IsEnabled="{Binding CanEditTeamInfo}"
   ToolTip="No se puede editar cuando la liga ya inició"  ToolTipService.ShowOnDisabled="True"/>

                </StackPanel>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Color principal"/>
                <xctk:ColorPicker Grid.Column="1" Grid.Row="1" SelectedColor="{Binding TeamPrimaryColor}" Height="40"/>
            </Grid>
           
           
            <TextBlock Grid.Row="1" Text="Logo" HorizontalAlignment="Center"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- URL (se llena automáticamente) -->
                <TextBox Grid.Column="0"
         Text="{Binding LogoFileName}"
         Style="{StaticResource ModernTextBoxStyle}"
         VerticalContentAlignment="Center"
         IsReadOnly="True"/>

                <!-- Botón subir -->
                <Button Grid.Column="1"  Content="Subir logo"
            Command="{Binding UploadLogoCommand}" Style="{StaticResource ThirdButtonStyle}"
            Margin="5,15,5,15" Width="90"
            />

                <!-- Preview -->
                <Border Width="70" Grid.Column="2" 
            Height="70"
            CornerRadius="35"
            Background="#EEEEEE">

                    <Image Source="{Binding LogoUrl}"
               Stretch="UniformToFill"/>
                </Border>

            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal">
                    <TextBlock Text="Representante"/>
                    <TextBlock Text=" *" Foreground="Red"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding TeamManager, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     VerticalContentAlignment="Center"
                     MaxLength="50"
                         Margin="0,0,5,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1"  Orientation="Horizontal">
                    <TextBlock Text="Telefono"/>
                    <TextBlock Text=" *" Foreground="Red"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding TeamManagerPhone, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TelephoneTextBoxStyle}"
                     VerticalContentAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="4" Text="Grupo"/>
            <ComboBox Grid.Row="5" Grid.Column="1"
                    Style="{StaticResource ModernComboBoxStyle}"
                    SelectedValue="{Binding SelectedGroup}"
                IsEnabled="{Binding CanEditTeamInfo}"
                        SelectedValuePath="Id"
                    ItemsSource="{Binding AvailableGroupNumbers}"
                    Height="40" 
                      IsEditable="False"
                      ToolTip="No se puede editar cuando la liga ya inició"  ToolTipService.ShowOnDisabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Row="6"
                        Height="40"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Width="90"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Guardar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="90"
                        Margin="20,0,0,0"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>