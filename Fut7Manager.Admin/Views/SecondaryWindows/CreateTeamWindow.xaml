<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.CreateTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear liga"
        Width="400"
        Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="White"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Nombre del Equipo"
                       Margin="0,0,0,5"/>

            <TextBox Grid.Row="1"
                     Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Height="40"
                     FontSize="16"
                     Padding="4,0,0,0"
                     VerticalContentAlignment="Center"
                     MaxLength="50"/>
            <TextBlock Grid.Row="2" Text="Logo"
                    Margin="0,0,0,5"/>
            <TextBox Grid.Row="3"
                     Text="{Binding LogoUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Height="40"
                     FontSize="16"
                     Padding="4,0,0,0"
                     VerticalContentAlignment="Center"
                     MaxLength="50"/>
            <TextBlock Grid.Row="4" Text="Grupo" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="5" Grid.Column="1"
                    Style="{StaticResource ModernComboBoxStyle}"
                    SelectedValue="{Binding SelectedGroup}"
                
                        SelectedValuePath="Id"
                    ItemsSource="{Binding AvailableGroupNumbers}"
                    Height="40"
                      IsEditable="False">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Row="6"
                        Height="40"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">

                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Width="90"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Guardar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="90"
                        Margin="20,0,0,0"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>