<Window x:Class="Fut7Manager.Admin.Views.SecondaryWindows.EditMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar partido"
        Width="400"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="White"
            BorderThickness="1"
            BorderBrush="Gray">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="{Binding MatchTitle}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Fecha -->
            <TextBlock Grid.Row="1" Text="Fecha" FontSize="14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date -->
                <DatePicker Grid.Column="0"
                            Style="{StaticResource ModernDatePickerStyle}"
                            SelectedDate="{Binding MatchDate}"
                            Height="35"/>

                <!-- Hour -->
                <ComboBox Grid.Column="1"
                          Width="70" Height="35"
                          Margin="5,0,0,0"
                          ItemsSource="{Binding Hours}"
                          SelectedItem="{Binding SelectedHour}"
                          Style="{StaticResource ModernComboBoxStyle}"/>

                <!-- Minutes -->
                <ComboBox Grid.Column="2"
                          Width="70"
                          Margin="5,0,0,0" Height="35"
                          ItemsSource="{Binding Minutes}"
                          SelectedItem="{Binding SelectedMinute}"
                          Style="{StaticResource ModernComboBoxStyle}"/>
            </Grid>

            <!-- Preview -->
            <TextBlock Grid.Row="3"
                       Text="{Binding FullDatePreview}"
                       Foreground="Gray"
                       FontStyle="Italic"
                       Margin="0,5,0,10"/>

            <!-- Lugar -->
            <TextBlock Grid.Row="4" Text="Lugar" FontSize="14"/>
            <TextBox Grid.Row="5"
                     Text="{Binding Location}"
                     Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Marcador -->
            <TextBlock Grid.Row="6"
                       Text="Marcador"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Padding="0"
                         Text="{Binding HomeGoals}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         HorizontalContentAlignment="Center" FontSize="24"
                         Width="60"/>

                <TextBlock Grid.Column="1"  Padding="0"
                           Text="vs" FontSize="24"
                           VerticalAlignment="Center"
                           />

                <TextBox Grid.Column="2"  Padding="0"
                         Text="{Binding AwayGoals}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         HorizontalContentAlignment="Center" FontSize="24"
                         Width="60"/>
            </Grid>

            <!-- Botones -->
            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0">

                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="40"
                        Margin="10,0,0,0"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Guardar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40"
                        Margin="10,0,0,0"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>