<UserControl x:Class="Fut7Manager.Admin.Views.PlayersView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >

    <Grid Margin="10">

        <DataGrid ItemsSource="{Binding Players}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Número" Binding="{Binding JerseyNumber}" Width="*"/>
                <DataGridTextColumn Header="Nacimiento" Binding="{Binding DateTime}" Width="*"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Phone}" Width="*"/>
                <DataGridTextColumn Header="Posición" Binding="{Binding PlayerPosition}" Width="*"/>
                <DataGridTextColumn Header="Goles" Binding="{Binding Goals}" Width="*"/>
                <DataGridTextColumn Header="Partidos Jugados" Binding="{Binding MatchesPlayed}" Width="*"/>
                <DataGridTextColumn Header="Activo" Binding="{Binding Active}" Width="*"/>
                <DataGridTextColumn Header="Equipo" Binding="{Binding TeamId}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>